# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Channel Username or Chat ID (e.g., @YourChannelUsername or -1001234567890)
# Note: The bot MUST be added as an Administrator in this channel!
CHANNEL_ID=@YourChannelUsername

# The public link or invite link to your channel (e.g., https://t.me/YourChannelUsername)
CHANNEL_INVITE_LINK=https://t.me/YourChannelUsername

# Optional: Admin Telegram User ID (numeric ID) for administrative commands (/addmovie, /stats, /broadcast)
# You can get your ID from @userinfobot or @raw_data_bot on Telegram
ADMIN_ID=0

# Optional: Custom database filename
DB_NAME=movies_bot.db
